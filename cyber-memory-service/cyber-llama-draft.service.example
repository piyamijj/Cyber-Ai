# =====================================================================================
# CYBER AI - ÇIRAK (DRAFT) MODEL SYSTEMD SERVİS ÖRNEĞİ (cyber-llama-draft.service)
# =====================================================================================
# Bu dosya, sunucunuzda (Oracle Cloud, 4 OCPU, GPU YOK) çalışan mevcut
# 'cyber-llama-draft' (0.5B, port 8088) servisinizi CPU çekişmesini (contention) önleyecek
# ve prompt caching (önbellekleme) özelliğini sistematik hale getirecek şekilde
# yapılandırmanız için bir REFERANS/DOKÜMANTASYON örneğidir.
#
# NASIL UYGULANIR?
# ----------------
# 1. Sunucunuzdaki mevcut servis dosyasını açın:
#    sudo nano /etc/systemd/system/cyber-llama-draft.service
# 2. Aşağıdaki 'Nice=' satırını ve 'ExecStart' içindeki cache-reuse parametrelerini
#    kendi dosyanıza entegre edin (dosya yollarını kendi sunucunuza göre doğrulayın).
# 3. Servisi yeniden yükleyin ve başlatın:
#    sudo systemctl daemon-reload
#    sudo systemctl restart cyber-llama-draft
# 4. Durumunu kontrol edin:
#    sudo systemctl status cyber-llama-draft
# =====================================================================================

[Unit]
Description=Cyber AI Draft (Çırak) LLM Server - qwen2.5-0.5b
After=network.target

[Service]
Type=simple
# NOT: Kullanıcı adınız 'ubuntu' değilse (whoami komutuyla kontrol edin),
# aşağıdaki User ve WorkingDirectory yollarını kendi kullanıcı adınızla değiştirin.
User=ubuntu
WorkingDirectory=/home/ubuntu

# -------------------------------------------------------------------------------------
# CPU ÇEKİŞMESİ (CONTENTION) ÖNLEME KATMANI (ÖNEMLİ!)
# -------------------------------------------------------------------------------------
# Nice=10: Çırak modelin CPU önceliğini düşürür (0 normal, 19 en düşük önceliktir).
# Bu sayede, Çırak (0.5B) ve Usta (14B) modelleri aynı anda çalışmaya başladığında,
# Linux çekirdeği CPU zamanını öncelikli olarak Usta modele (Nice=0) ayırır.
# Bu, kod seviyesinde paralel akış (erken tetikleme) açılsa bile Usta modelin
# token üretim hızının (tokens per second) düşmesini ve kilitlenmeleri önler.
Nice=10

# ALTERNATİF (DAHA SERT) İZOLASYON: Çekirdek Sabitleme (Core Pinning)
# Eğer 'Nice=10' çekişmeyi tamamen çözmezse, Çırak modeli sadece belirli CPU çekirdeklerine
# sabitleyebilirsiniz. Örneğin, Çırak'ı 0 ve 1. çekirdeklere sabitlemek için ExecStart satırının
# başına 'taskset -c 0,1' ekleyebilirsiniz.
# Örnek (Yorum satırını kaldırmak isterseniz):
# ExecStart=/usr/bin/taskset -c 0,1 /home/ubuntu/llama.cpp/build/bin/llama-server ...

# -------------------------------------------------------------------------------------
# PROMPT CACHING VE BAŞLATMA PARAMETRELERİ
# -------------------------------------------------------------------------------------
# DÜZELTME (kritik hata): '--prompt-cache' ve '--prompt-cache-all' bayrakları
# llama-server TARAFINDAN DESTEKLENMEZ — bunlar llama-cli'nin (tekli komut satırı aracı)
# bayraklarıdır, sunucu bu bayrakları görünce "invalid argument" hatasıyla başlamayı
# reddeder. llama-server'ın resmi dokümantasyonuna göre (tools/server/README.md) doğru
# eşdeğerleri:
# --cache-reuse N: KV-shifting ile önbellekten yeniden kullanılacak minimum parça
#   boyutu. Ortak sistem talimatları ve Shared Context (RAG/Web) doküman paketi turlar
#   arası AYNI kaldığı için, bu bayrak sayesinde llama.cpp bu ortak öneki (prefix) her
#   turda yeniden hesaplamaz.
# --cache-prompt zaten VARSAYILAN OLARAK AÇIKTIR, ayrıca belirtmeye gerek yoktur.
# -t 2: Çırak modelin sadece 2 CPU çekirdeği (thread) kullanmasını sağlar. Bu, 4 OCPU'lu
#   sunucuda usta modele her zaman en az 2 çekirdeklik boş alan bırakılmasını garanti eder.
# --chat-template chatml: KRİTİK DÜZELTME (canlı site testinde bulundu — "PAPAGAN/ECHO"
#   REGRESYONU). Kullanıcı canlı sitede modelin kullanıcının SORUSUNU cevaplamak yerine,
#   soruyu hafifçe değiştirip (emir kipinden soru kipine çevirip) GERİ YAZDIĞINI gözlemledi
#   ("Bugünün haber başlıklarını ver" -> "Bugünün haberlerin başlıklarını belirtin.") — bu,
#   instruct-tuned bir modelin bile chat template'i YANLIŞ/EKSİK uygulandığında sergilediği
#   KLASİK "metni doğal devamıyla tamamla" (base-model-benzeri) davranışıdır. Kök neden
#   ihtimali: llama-server, --chat-template AÇIKÇA belirtilmediğinde GGUF dosyasının
#   içindeki tokenizer.chat_template metadata alanına güvenir — bu alan bu spesifik GGUF
#   dönüştürmesinde eksik/hatalıysa, sunucu SESSİZCE genel/varsayılan bir şablona (ChatML
#   DEĞİL) düşer ve model kendi eğitildiği formatla UYUŞMAYAN bir prompt görür. Bunu
#   ihtimalden çıkarmak için Qwen2.5 ailesinin resmi ChatML formatını AÇIKÇA zorluyoruz
#   (llama.cpp resmi wiki'sinde doğrulandı: <|im_start|>/<|im_end|> formatı = "chatml" adı).
# -c 4096 -> 8192: KRİTİK DÜZELTME (canlı site testinde bulundu — "MENÜ/UI METNİ HALÜSİNASYONU
#   + TEK KELİMELİK ANLAMSIZ LİSTE" REGRESYONU, önceki fix'lerden SONRA ortaya çıkan EN VAHIM
#   belirti). Kök neden: llama-server, --no-context-shift AÇIKÇA verilmediği sürece VARSAYILAN
#   OLARAK "context shift" özelliğiyle çalışır (llama.cpp resmi dokümantasyonuyla doğrulandı) —
#   yani context penceresi (-c 4096) dolduğunda, sunucu HİÇBİR HATA VERMEDEN en ESKİ token'ları
#   (ki bu genellikle SİSTEM PROMPTUNUN BAŞI/kuralları demektir) SESSİZCE atıp yerlerine yeni
#   token ekler. Bu proje boyunca (chat-template, papağan-yasağı, kimlik kuralı, RAG/web
#   etiketleme vb.) sistem promptu VE web arama sonuç sayısı (WEB_SEARCH_MAX_RESULTS 4->8)
#   TUR TUR BÜYÜDÜ — toplam prompt boyutu (sistem promptu + 8 web sonucu + RAG verisi +
#   konuşma geçmişi) muhtemelen 4096 token sınırını AŞMAYA başladı, llama-server modelin
#   KENDİ TALİMATLARININ BİR KISMINI sessizce kırpmaya başladı. Model, eksik/parçalanmış bir
#   talimat setiyle baş başa kalınca tutarlı bir cevap üretemedi — bu, gözlenen "kendi menü/arayüz
#   kelimelerini anlamsızca tekrarlama" ve "10 madde ama her biri tek anlamsız kelime" belirtilerini
#   TAM OLARAK açıklar (klasik context-overflow/fragmentation davranışı). Çözüm: context
#   penceresini 8192'ye çıkararak (usta modelin zaten kullandığı boyutla eşitleyerek) gerçek
#   promptun HİÇBİR ZAMAN sınırı aşmamasını sağlıyoruz — bu, sorunu YAPISAL olarak ortadan kaldırır
#   (sampling parametresi ayarlamaktan farklı olarak, kök nedeni doğrudan çözer).
ExecStart=/home/ubuntu/llama.cpp/build/bin/llama-server \
  -m /home/ubuntu/models/qwen2.5-0.5b-instruct-q4_k_m.gguf \
  --port 8088 \
  --host 0.0.0.0 \
  -c 8192 \
  --cache-reuse 256 \
  --chat-template chatml \
  -t 2

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

# =====================================================================================
# PROMPT CACHING VE PERFORMANS NOTLARI:
# -------------------------------------
# 1. Usta Model (14B, Port 8082) İçin Öneri:
#    Usta modelinizin kendi systemd servisinde veya başlatma scriptinde de benzer şekilde
#    --cache-reuse 256 parametresini kullanmanız, usta modelin de Shared Context'i her
#    turda baştan hesaplamasını önleyerek sıcak başlangıç süresini (warm-start) 281ms
#    seviyesine düşürür. (--prompt-cache/--prompt-cache-all KULLANMAYIN — llama-server
#    bu bayrakları desteklemez, "invalid argument" hatası verir; bunlar llama-cli'ye özeldir.)
#
# 2. Thread Sayısı (-t):
#    4 OCPU sunucuda, Çırak için '-t 2', Usta için ise '-t 4' (veya Nice=10 ile serbest)
#    kullanılması en dengeli performansı sağlar.
# =====================================================================================